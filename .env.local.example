# Local development environment variables
# Copy this file to .env.local for local development overrides

# Shopify App Credentials (override .env values for local testing)
SHOPIFY_API_KEY=your_local_api_key
SHOPIFY_API_SECRET=your_local_api_secret

# Local development URL
SHOPIFY_APP_URL=https://localhost:3000

# Database (local SQLite for development)
DATABASE_URL=file:./dev.local.sqlite

# Optional: Test shop domain for development
SHOP_CUSTOM_DOMAIN=your-test-shop.myshopify.com

# Optional: Enable debug logging
DEBUG=true
LOG_LEVEL=debug
